{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mount-charter.local/schemas/frameworks.schema.json",
  "title": "Mount Charter Multi-Framework Catalog",
  "type": "object",
  "required": ["version", "lastVerified", "frameworks"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "shortName",
          "version",
          "jurisdiction",
          "scoringMode",
          "supportTier",
          "description",
          "defaultEnabled",
          "sortOrder",
          "requirements"
        ],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 2 },
          "shortName": { "type": "string", "minLength": 2 },
          "version": { "type": "string", "minLength": 1 },
          "jurisdiction": { "type": "string", "enum": ["International", "Australia", "EU"] },
          "instrumentId": { "type": ["string", "null"] },
          "sourceUrl": { "type": ["string", "null"] },
          "effectiveDate": { "type": ["string", "null"] },
          "transitionNote": { "type": ["string", "null"] },
          "scoringMode": {
            "type": "string",
            "enum": ["pass_fail", "maturity_0_3", "window_attestation", "statutory_register"]
          },
          "supportTier": {
            "type": "string",
            "enum": ["full", "cross_mapped", "ai_context_only"]
          },
          "description": { "type": "string", "minLength": 10 },
          "defaultEnabled": { "type": "boolean" },
          "sortOrder": { "type": "integer", "minimum": 1 },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reqCode",
                "domain",
                "title",
                "description",
                "sortOrder",
                "isoMappings"
              ],
              "properties": {
                "reqCode": { "type": "string", "minLength": 2 },
                "clauseRef": { "type": ["string", "null"] },
                "domain": { "type": "string", "minLength": 2 },
                "title": { "type": "string", "minLength": 3 },
                "description": { "type": "string", "minLength": 10 },
                "guidance": { "type": ["string", "null"] },
                "levelOrCategory": { "type": ["string", "null"] },
                "prescriptiveSla": { "type": ["object", "null"] },
                "deadlineDate": { "type": ["string", "null"] },
                "isDraft": { "type": "boolean" },
                "evidenceExpected": { "type": ["string", "null"] },
                "sortOrder": { "type": "integer", "minimum": 1 },
                "isoMappings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["controlNumber", "coverage"],
                    "properties": {
                      "controlNumber": { "type": "string", "minLength": 2 },
                      "coverage": {
                        "type": "string",
                        "enum": ["full", "partial", "delta_required", "rubric_conflict"]
                      },
                      "notes": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
