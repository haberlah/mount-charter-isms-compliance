# Mount Charter ISMS Compliance — Local Desktop Configuration
# Copy to .env for optional CLI/dev overrides. In the macOS app, cloud API keys
# are stored in macOS Keychain (Settings -> AI Providers & Subscriptions).

# Loopback HTTP engine port (default 3852, bound strictly to 127.0.0.1)
MOUNT_CHARTER_PORT=3852

# Optional data directory override (default: ~/Library/Application Support/Mount Charter)
# MOUNT_CHARTER_DATA_DIR=

# Optional provider API key fallbacks when not stored in macOS Keychain
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# XAI_API_KEY=xai-...
# META_API_KEY=...
# CUSTOM_LLM_API_KEY=...
